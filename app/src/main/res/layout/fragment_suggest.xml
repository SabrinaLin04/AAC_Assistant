<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="viewModel"
            type="it.lbsl.aacassistant.LlmViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <LinearLayout
            android:id="@+id/loadingGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:visibility="visible">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@mipmap/ic_launcher_round"
                android:contentDescription="@string/chat_app_icon" />

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="32dp"
                android:indeterminateTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:text="@string/model_loading_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:text="@string/model_loading_subtitle" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/errorGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_info"
                app:tint="?attr/colorError" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/error_title"
                android:textAppearance="@style/TextAppearance.App.SectionLabel"
                android:textColor="?attr/colorError" />

            <TextView
                android:id="@+id/errorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.App.Body" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/chatGroup"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/demoBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/aac_warning_container"
                android:textColor="@color/aac_on_warning_container"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:text="@string/demo_mode_banner"
                android:textAppearance="@style/TextAppearance.App.Body"
                android:visibility="gone" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/contextBar"
                android:background="?attr/colorSurfaceVariant"
                android:elevation="2dp"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp">

                <View
                    android:id="@+id/contextColorBar"
                    android:layout_width="@dimen/context_color_bar_width"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:background="@color/aac_primary"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/contextBarPictogram"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/contextLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    android:text="@string/context_none" />

                <TextView
                    android:id="@+id/statusIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/status_available"
                    android:text="@string/chat_status_available" />

            </LinearLayout>

            <include
                android:id="@+id/hintBarInclude"
                layout="@layout/include_hint_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp" />

            <!-- le frasi salvate per questo posto vengono prima di tutto: sono quelle già note -->
            <LinearLayout
                android:id="@+id/savedGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/saved_here_title"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/savedChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:singleLine="true" />

                </HorizontalScrollView>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/suggestButton"
                style="@style/Widget.AAC.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:minHeight="64dp"
                android:text="@string/action_suggest"
                android:textAppearance="@style/TextAppearance.App.Title"
                android:textColor="?attr/colorOnPrimary"
                app:icon="@drawable/ic_auto_awesome"
                app:iconGravity="textStart"
                app:iconSize="24dp" />

            <ProgressBar
                android:id="@+id/suggestProgressBar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="4dp"
                android:contentDescription="@string/model_loading_title"
                android:indeterminateTint="?attr/colorPrimary"
                android:visibility="gone"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="12dp"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/bottomContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:elevation="4dp"
                android:orientation="vertical"
                android:paddingTop="8dp">

                <!-- scelta esplicita: una cosa da dire o una cosa detta dall'altra persona -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/modeToggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    app:checkedButton="@+id/modeIntention"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeIntention"
                        style="@style/Widget.AAC.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_intention" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/modeReply"
                        style="@style/Widget.AAC.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_reply" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pictogramBoard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/board_height"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:contentDescription="@string/board_description"
                    android:paddingHorizontal="8dp"
                    android:scrollbars="vertical" />

                <LinearLayout
                    android:id="@+id/inputBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageButton
                        android:id="@+id/boardToggle"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/board_hide"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_keyboard"
                        app:tint="?attr/colorPrimary" />

                    <EditText
                        android:id="@+id/messageInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/input_background"
                        android:gravity="center_vertical"
                        android:hint="@string/input_hint_intention"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="4"
                        android:minHeight="@dimen/touch_target_min"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textAppearance="@style/TextAppearance.App.Message"
                        android:textColorHint="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/eraseWordButton"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/erase_word"
                        android:padding="10dp"
                        android:src="@drawable/ic_backspace"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <ImageButton
                        android:id="@+id/sendButton"
                        android:layout_width="@dimen/touch_target_min"
                        android:layout_height="@dimen/touch_target_min"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/send_button_background"
                        android:contentDescription="@string/chat_send"
                        android:enabled="false"
                        android:padding="12dp"
                        android:src="@drawable/ic_send" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>