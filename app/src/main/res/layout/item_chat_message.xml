<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="message"
            type="it.lbsl.aacassistant.ChatMessage" />
    </data>

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/authorLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.App.Caption"
            android:text='@{message.author.equals("user") ? @string/chat_author_user : @string/chat_author_assistant}'
            tools:text="Assistente" />

        <LinearLayout
            android:id="@+id/bubbleColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/pictogramScrollView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_pictogram_strip"
                android:fadeScrollbars="false"
                android:focusable="true"
                android:paddingHorizontal="8dp"
                android:paddingVertical="8dp"
                android:scrollbarSize="4dp"
                android:scrollbars="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/pictogramStrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

            </HorizontalScrollView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/textBubbleRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/messageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="14dp"
                    android:textAppearance="@style/TextAppearance.App.Message"
                    android:text="@{message.text}"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/favoriteStar"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="0.0"
                    tools:text="Mi piace giocare con i miei figli" />

                <ImageButton
                    android:id="@+id/favoriteStar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="14dp"
                    android:src="@android:drawable/btn_star_big_off"
                    android:contentDescription="@string/action_toggle_favorite"
                    app:layout_constraintStart_toEndOf="@id/messageText"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/messageText"
                    app:layout_constraintBottom_toBottomOf="@id/messageText"
                    app:layout_constraintHorizontal_bias="0.0" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </LinearLayout>
</layout>