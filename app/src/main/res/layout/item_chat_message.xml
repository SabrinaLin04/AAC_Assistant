<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable
            name="message"
            type="it.lbsl.aacassistant.ChatMessage" />
    </data>

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/authorLabel"
            android:text='@{message.author.equals("user") ? @string/chat_author_user : @string/chat_author_assistant}'
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="2dp"
            android:paddingHorizontal="6dp"
            android:textColor="#999999"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/bubbleRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/messageText"
            android:text="@{message.text}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:lineSpacingExtra="2dp"
            android:textSize="15sp" />

            <ImageButton
                android:id="@+id/favoriteStar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@android:drawable/btn_star_big_off"
                android:contentDescription="@string/favorite_added"
                android:visibility="gone" />

    </LinearLayout>

</layout>