<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="14dp"
        android:layout_marginVertical="5dp"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="76dp"
        app:cardBackgroundColor="@color/aac_surface_container"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- il colore rinforza nome e pittogramma, non è mai l'unica informazione -->
            <View
                android:id="@+id/colorBar"
                android:layout_width="@dimen/context_color_bar_width"
                android:layout_height="match_parent"
                android:background="@color/aac_context_4" />

            <ImageView
                android:id="@+id/contextPictogram"
                android:layout_width="@dimen/pictogram_context_size"
                android:layout_height="@dimen/pictogram_context_size"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="12dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pictogram_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/contextName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.App.Title"
                    tools:text="Dal medico" />

                <TextView
                    android:id="@+id/phraseCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    android:visibility="gone"
                    tools:text="12 frasi"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/contextDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.App.Caption"
                    tools:text="Ambulatorio, sintomi, dolore" />

            </LinearLayout>

            <TextView
                android:id="@+id/activeIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_active_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/context_active"
                android:textAppearance="@style/TextAppearance.App.Caption"
                android:textColor="@color/aac_on_success"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- modifica visibile: la pressione prolungata resta solo come scorciatoia -->
            <ImageButton
                android:id="@+id/editButton"
                android:contentDescription="@string/edit_context_title"
                android:layout_width="@dimen/touch_target_min"
                android:layout_height="@dimen/touch_target_min"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_edit"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
