<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- striscia di aiuto: sta accanto alla cosa che spiega e si chiude -->
    <LinearLayout
        android:id="@+id/hintBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hint"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/hintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.Hint"
            tools:text="@string/hint_contexts" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hintDismiss"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/action_understood"
            android:textAllCaps="false"
            android:textColor="@color/aac_hint_container"
            app:backgroundTint="@color/aac_on_hint_container"
            app:cornerRadius="12dp" />

    </LinearLayout>
</layout>
