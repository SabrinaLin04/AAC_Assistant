    <!-- colori dei contesti: rinforzano nome e pittogramma, non li sostituiscono -->
    <color name="aac_context_1">#B84A4A</color>
    <color name="aac_context_2">#8A6D1F</color>
    <color name="aac_context_3">#3A735C</color>
    <color name="aac_context_4">#426F8F</color>

    <array name="aac_context_colors">
        <item>@color/aac_context_1</item>
        <item>@color/aac_context_2</item>
        <item>@color/aac_context_3</item>
        <item>@color/aac_context_4</item>
    </array>

    <!-- striscia di aiuto: stessa tinta del banner demo, già definita anche per la notte -->
    <color name="aac_hint_container">@color/aac_warning_container</color>
    <color name="aac_on_hint_container">@color/aac_on_warning_container</color>

    <!-- evidenziazione della parola in lettura: rosso chiaro, uguale in chiaro e in scuro
         perché sta sempre su fondo bianco, sia nel testo sia dietro al pittogramma -->
    <color name="aac_highlight">#F0C0C0</color>
    <color name="aac_on_highlight">#5C2020</color>

    <!-- barra di annullamento -->
    <color name="aac_undo_container">#1E3A4C</color>
    <color name="aac_on_undo_container">#FFFFFF</color>
