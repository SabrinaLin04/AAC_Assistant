<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.App.Message" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.45</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.App.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.App.Caption" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.AAC.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">24dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.AAC.Button.Primary" parent="Widget.AAC.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>
    <style name="Widget.AAC.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/aac_surface_container</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">1dp</item>
    </style>

    <style name="ThemeOverlay.AACAssistant.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/aac_primary</item>
        <item name="colorOnPrimary">@color/aac_on_primary</item>
        <item name="colorSurface">@color/aac_surface_container</item>
        <item name="colorSurfaceContainer">@color/aac_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/aac_surface_container</item>
        <item name="colorSurfaceContainerHighest">@color/aac_surface_container</item>
        <item name="android:colorBackground">@color/aac_surface_container</item>
    </style>

    <style name="Theme.AACAssistant.FirebaseUI" parent="FirebaseUI">
        <item name="colorPrimary">@color/aac_primary</item>
        <item name="colorOnPrimary">@color/aac_on_primary</item>
        <item name="colorPrimaryContainer">@color/aac_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/aac_on_primary_container</item>
    </style>

</resources>
